# DeepSeek（服务端读取，不会进入浏览器 bundle）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 默认关闭思考模式以便 Writing Agent 更快返回结构化 JSON；需要时改为 enabled
DEEPSEEK_THINKING=disabled

# 编辑器登录
SELFWEB_EDITOR_SECRET=replace-with-a-long-random-secret
SELFWEB_EDITOR_PASSWORD=replace-with-your-editor-password

# 发布到 GitHub（仅使用“发布”功能时需要）
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# 可选：未配置 DeepSeek 时兼容旧的 OpenAI 配置
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
